import React, { useState, useEffect, useRef, useLayoutEffect, useCallback } from "react";
import { Search, Settings, Home, Briefcase, Plus, X, GripVertical, ChevronRight, Atom } from "lucide-react";

// ---------- helpers ----------
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);

const CATEGORY_COLORS = [
  { name: "Rosa", value: "#c97b84" },
  { name: "Areia", value: "#d4a373" },
  { name: "Sálvia", value: "#8fa998" },
  { name: "Azul", value: "#7c94b0" },
  { name: "Malva", value: "#a8899f" },
  { name: "Oliva", value: "#8a9a5b" },
];

const PRIORITIES = [
  { key: "baixa", label: "Baixa", color: "#8b8f98" },
  { key: "media", label: "Média", color: "#c99a4a" },
  { key: "alta", label: "Alta", color: "#b8534f" },
];

const TABS = [
  { key: "pessoal", label: "Pessoal", accent: "#c97b84", Icon: Home },
  { key: "profissional", label: "Profissional", accent: "#7c94b0", Icon: Briefcase },
];

const STORAGE_KEY = "mindmap-app-data";

const emptyData = () => ({
  pessoal: { categories: [] },
  profissional: { categories: [] },
});

const newCategory = (name: string, color: string) => ({
  id: uid(),
  name,
  color,
  expanded: true,
  tasks: [] as any[],
});

const newTask = (title: string) => ({
  id: uid(),
  title,
  description: "",
  priority: "media",
  dueDate: "",
  done: false,
  checklist: [] as any[],
});

function isOverdue(dueDate: string, done: boolean) {
  if (!dueDate || done) return false;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return new Date(dueDate + "T00:00:00") < today;
}

function formatDate(iso: string) {
  const [y, m, d] = iso.split("-");
  return `${d}/${m}`;
}

// ---------- main component ----------
export default function MindMapTasks() {
  const [data, setData] = useState<any>(null);
  const [loaded, setLoaded] = useState(false);
  const [activeTab, setActiveTab] = useState("pessoal");
  const [panelTask, setPanelTask] = useState<any>(null);
  const [addingCategory, setAddingCategory] = useState(false);
  const [newCatName, setNewCatName] = useState("");
  const [newCatColor, setNewCatColor] = useState(CATEGORY_COLORS[0].value);
  const [links, setLinks] = useState<string[]>([]);
  const [tick, setTick] = useState(0);
  const [searchQuery, setSearchQuery] = useState("");
  const [draggedCatId, setDraggedCatId] = useState<string | null>(null);
  const [dragOverCatId, setDragOverCatId] = useState<string | null>(null);
  const [confirmState, setConfirmState] = useState<any>(null);

  const containerRef = useRef<HTMLDivElement>(null);
  const nodeRefs = useRef<Record<string, HTMLElement>>({});
  const saveTimeout = useRef<NodeJS.Timeout | null>(null);

  useEffect(() => {
    (async () => {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        setData(stored ? JSON.parse(stored) : emptyData());
      } catch (e) {
        setData(emptyData());
      } finally {
        setLoaded(true);
      }
    })();
  }, []);

  useEffect(() => {
    if (!loaded || !data) return;
    if (saveTimeout.current) clearTimeout(saveTimeout.current);
    saveTimeout.current = setTimeout(() => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (e) {}
    }, 400);
    return () => {
      if (saveTimeout.current) clearTimeout(saveTimeout.current);
    };
  }, [data, loaded]);

  const setNodeRef = useCallback((id: string) => (el: HTMLElement | null) => {
    if (el) nodeRefs.current[id] = el;
    else delete nodeRefs.current[id];
  }, []);

  const tabData = data ? data[activeTab] : null;

  const visibleCategories = React.useMemo(() => {
    if (!tabData) return [];
    const q = searchQuery.trim().toLowerCase();
    if (!q) return tabData.categories;
    return tabData.categories
      .map((cat: any) => {
        const catMatches = cat.name.toLowerCase().includes(q);
        const tasks = catMatches ? cat.tasks : cat.tasks.filter((t: any) => t.title.toLowerCase().includes(q));
        if (!catMatches && tasks.length === 0) return null;
        return { ...cat, tasks };
      })
      .filter(Boolean);
  }, [tabData, searchQuery]);

  function pathBetween(fromEl: HTMLElement, toEl: HTMLElement) {
    const fx = fromEl.offsetLeft + fromEl.offsetWidth;
    const fy = fromEl.offsetTop + fromEl.offsetHeight / 2;
    const tx = toEl.offsetLeft;
    const ty = toEl.offsetTop + toEl.offsetHeight / 2;
    const midX = fx + (tx - fx) / 2;
    return `M ${fx} ${fy} C ${midX} ${fy}, ${midX} ${ty}, ${tx} ${ty}`;
  }

  useLayoutEffect(() => {
    if (!containerRef.current) return;
    const compute = () => {
      const centerEl = nodeRefs.current["center"];
      if (!centerEl) return;
      const newLinks: string[] = [];
      visibleCategories.forEach((cat: any) => {
        const catEl = nodeRefs.current[cat.id];
        if (catEl) newLinks.push(pathBetween(centerEl, catEl));
      });
      setLinks(newLinks);
    };
    const raf = requestAnimationFrame(compute);
    return () => cancelAnimationFrame(raf);
  }, [visibleCategories, activeTab, tick, panelTask]);

  useEffect(() => {
    const onResize = () => setTick((t) => t + 1);
    window.addEventListener("resize", onResize);
    const ro = new ResizeObserver(() => setTick((t) => t + 1));
    if (containerRef.current) ro.observe(containerRef.current);
    return () => {
      window.removeEventListener("resize", onResize);
      ro.disconnect();
    };
  }, []);

  function askConfirm(message: string, onConfirm: () => void) {
    setConfirmState({ message, onConfirm });
  }

  function updateTab(mutator: (tab: any) => any) {
    setData((prev: any) => {
      const next = { ...prev };
      next[activeTab] = mutator(structuredClone(prev[activeTab]));
      return next;
    });
  }

  function addCategory() {
    const name = newCatName.trim();
    if (!name) return;
    updateTab((tab: any) => {
      tab.categories.push(newCategory(name, newCatColor));
      return tab;
    });
    setNewCatName("");
    setNewCatColor(CATEGORY_COLORS[0].value);
    setAddingCategory(false);
  }

  function deleteCategory(catId: string) {
    const cat = tabData.categories.find((c: any) => c.id === catId);
    if (!cat) return;
    askConfirm(`Excluir a categoria "${cat.name}" e todas as suas tarefas?`, () => {
      updateTab((tab: any) => {
        tab.categories = tab.categories.filter((c: any) => c.id !== catId);
        return tab;
      });
      setConfirmState(null);
    });
  }

  function toggleExpand(catId: string) {
    updateTab((tab: any) => {
      const c = tab.categories.find((c: any) => c.id === catId);
      if (c) c.expanded = !c.expanded;
      return tab;
    });
  }

  function reorderCategory(draggedId: string | null, targetId: string) {
    if (!draggedId || draggedId === targetId) return;
    updateTab((tab: any) => {
      const fromIdx = tab.categories.findIndex((c: any) => c.id === draggedId);
      const toIdx = tab.categories.findIndex((c: any) => c.id === targetId);
      if (fromIdx === -1 || toIdx === -1) return tab;
      const [moved] = tab.categories.splice(fromIdx, 1);
      tab.categories.splice(toIdx, 0, moved);
      return tab;
    });
  }

  function openNewTask(catId: string) {
    setPanelTask({ categoryId: catId, isNew: true, draft: newTask("") });
  }
  function openTask(catId: string, taskId: string) {
    setPanelTask({ categoryId: catId, taskId });
  }
  function saveNewTask(catId: string, task: any) {
    if (!task.title.trim()) return;
    updateTab((tab: any) => {
      const cat = tab.categories.find((c: any) => c.id === catId);
      if (cat) cat.tasks.push(task);
      return tab;
    });
    setPanelTask(null);
  }
  function patchTask(catId: string, taskId: string, patch: any) {
    updateTab((tab: any) => {
      const cat = tab.categories.find((c: any) => c.id === catId);
      const t = cat && cat.tasks.find((t: any) => t.id === taskId);
      if (t) Object.assign(t, patch);
      return tab;
    });
  }
  function moveTaskToCategory(fromCatId: string, taskId: string, toCatId: string) {
    if (fromCatId === toCatId) return;
    updateTab((tab: any) => {
      const fromCat = tab.categories.find((c: any) => c.id === fromCatId);
      const toCat = tab.categories.find((c: any) => c.id === toCatId);
      const idx = fromCat.tasks.findIndex((t: any) => t.id === taskId);
      if (idx === -1) return tab;
      const [task] = fromCat.tasks.splice(idx, 1);
      toCat.tasks.push(task);
      return tab;
    });
    setPanelTask({ categoryId: toCatId, taskId });
  }
  function deleteTask(catId: string, taskId: string) {
    askConfirm("Excluir esta tarefa?", () => {
      updateTab((tab: any) => {
        const cat = tab.categories.find((c: any) => c.id === catId);
        if (cat) cat.tasks = cat.tasks.filter((t: any) => t.id !== taskId);
        return tab;
      });
      setPanelTask(null);
      setConfirmState(null);
    });
  }
  function toggleTaskDone(catId: string, taskId: string) {
    updateTab((tab: any) => {
      const cat = tab.categories.find((c: any) => c.id === catId);
      const t = cat && cat.tasks.find((t: any) => t.id === taskId);
      if (t) t.done = !t.done;
      return tab;
    });
  }

  if (!loaded || !data) {
    return (
      <div style={{ ...styles.app, alignItems: "center", justifyContent: "center" }}>
        <span style={{ color: "#8b8f98", fontFamily: "'Inter', sans-serif" }}>Carregando…</span>
      </div>
    );
  }

  const tabMeta = TABS.find((t) => t.key === activeTab);
  const openTaskObj =
    panelTask && !panelTask.isNew
      ? tabData.categories.find((c: any) => c.id === panelTask.categoryId)?.tasks.find((t: any) => t.id === panelTask.taskId)
      : null;

  return (
    <div style={styles.app}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap');
        * { box-sizing: border-box; }
        .mm-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
        .mm-scroll::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 4px; }
        .mm-node-btn { opacity: 0; transition: opacity .15s ease; }
        .mm-node:hover .mm-node-btn { opacity: 1; }
        .mm-map-item { transition: background .15s ease; cursor: pointer; }
        input, textarea, select { font-family: 'Inter', sans-serif; }
      `}</style>

      {/* sidebar */}
      <div style={styles.sidebar}>
        <div style={styles.logoRow}>
          <div style={styles.logoIconWrap}>
            <Atom size={22} color="#dba18e" strokeWidth={1.8} />
          </div>
          <span style={styles.logoText}>synapse</span>
        </div>

        <div style={styles.searchRow}>
          <Search size={15} color="#6b6f78" />
          <input
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="buscar"
            style={styles.searchInput}
          />
        </div>

        <div style={styles.settingsRow}>
          <Settings size={15} color="#6b6f78" />
          <span>configurações</span>
        </div>

        <div style={styles.sectionLabel}>meus mapas</div>
        <div>
          {TABS.map((t) => {
            const selected = activeTab === t.key;
            return (
              <div
                key={t.key}
                className="mm-map-item"
                onClick={() => setActiveTab(t.key)}
                style={{
                  ...styles.mapItem,
                  background: selected ? "rgba(255,255,255,0.06)" : "transparent",
                  borderLeft: selected ? `2px solid ${t.accent}` : "2px solid transparent",
                }}
              >
                <t.Icon size={15} color={selected ? t.accent : "#71757e"} strokeWidth={1.8} />
                <span style={{ color: selected ? "#eceae4" : "#9a9ea6" }}>{t.label}</span>
              </div>
            );
          })}
        </div>
      </div>

      {/* main */}
      <div style={styles.main}>
        <div style={styles.mainHeader}>
          <span style={styles.mainHeaderText}>mapa mental: {tabMeta?.label.toLowerCase()}</span>
        </div>

        <div ref={containerRef} className="mm-scroll" style={styles.canvas}>
          <svg width={containerRef.current?.scrollWidth || "100%"} height={containerRef.current?.scrollHeight || "100%"} style={styles.svg}>
            {links.map((d, i) => (
              <path key={i} d={d} stroke="#c9bfa8" strokeWidth="1.5" fill="none" />
            ))}
          </svg>

          <div style={styles.treeWrap}>
            <div ref={setNodeRef("center")} style={{ ...styles.centerNode, borderColor: tabMeta?.accent }}>
              {tabMeta?.label}
            </div>

            <div style={styles.categoryStack}>
              {visibleCategories.length === 0 && !addingCategory && (
                <div style={styles.emptyState}>
                  {searchQuery
                    ? "Nenhum resultado para essa busca."
                    : `Nenhuma categoria ainda. Crie a primeira para começar a mapear suas ${activeTab === "pessoal" ? "tarefas pessoais" : "tarefas profissionais"}.`}
                </div>
              )}

              {visibleCategories.map((cat: any) => (
                <div
                  key={cat.id}
                  ref={setNodeRef(cat.id)}
                  className="mm-node"
                  draggable
                  onDragStart={() => setDraggedCatId(cat.id)}
                  onDragEnd={() => {
                    setDraggedCatId(null);
                    setDragOverCatId(null);
                  }}
                  onDragOver={(e) => {
                    e.preventDefault();
                    if (dragOverCatId !== cat.id) setDragOverCatId(cat.id);
                  }}
                  onDrop={(e) => {
                    e.preventDefault();
                    reorderCategory(draggedCatId, cat.id);
                    setDragOverCatId(null);
                  }}
                  style={{
                    ...styles.categoryCard,
                    borderLeft: `3px solid ${cat.color}`,
                    opacity: draggedCatId === cat.id ? 0.4 : 1,
                    outline: dragOverCatId === cat.id && draggedCatId !== cat.id ? `2px dashed ${cat.color}` : "none",
                    outlineOffset: 2,
                  }}
                >
                  <div style={styles.categoryHeaderRow}>
                    <GripVertical size={13} color="#4a4d54" style={{ cursor: "grab", flexShrink: 0 }} />
                    <span style={styles.categoryName} onClick={() => toggleExpand(cat.id)}>
                      {cat.name}
                    </span>
                    <span style={styles.taskCount}>
                      {cat.tasks.filter((t: any) => !t.done).length}/{cat.tasks.length}
                    </span>
                    <ChevronRight
                      size={14}
                      color="#71757e"
                      onClick={() => toggleExpand(cat.id)}
                      style={{ cursor: "pointer", transform: cat.expanded ? "rotate(90deg)" : "rotate(0deg)", transition: "transform .15s ease" }}
                    />
                    <div style={styles.categoryActions}>
                      <button style={styles.iconBtn} onClick={() => openNewTask(cat.id)}>
                        <Plus size={12} />
                      </button>
                      <button style={styles.iconBtn} onClick={() => deleteCategory(cat.id)}>
                        <X size={12} />
                      </button>
                    </div>
                  </div>

                  {cat.expanded && (
                    <div style={styles.taskList}>
                      {cat.tasks.map((task: any) => {
                        const overdue = isOverdue(task.dueDate, task.done);
                        const priority = PRIORITIES.find((p) => p.key === task.priority);
                        return (
                          <div
                            key={task.id}
                            style={{ ...styles.taskRow, background: task.done ? "rgba(0,0,0,0.1)" : "transparent" }}
                            onClick={() => openTask(cat.id, task.id)}
                          >
                            <div
                              style={{
                                ...styles.checkbox,
                                background: task.done ? "#8fa998" : "transparent",
                                borderColor: task.done ? "#8fa998" : "#71757e",
                              }}
                            >
                              {task.done ? "✓" : ""}
                            </div>
                            <span style={{ ...styles.taskRowTitle, textDecoration: task.done ? "line-through" : "none" }}>{task.title}</span>
                            {task.dueDate && (
                              <span
                                style={{
                                  ...styles.pill,
                                  background: overdue ? "#b8534f44" : "#71757e33",
                                  color: overdue ? "#ff8b7e" : "#8b8f98",
                                }}
                              >
                                {formatDate(task.dueDate)}
                              </span>
                            )}
                            {priority && (
                              <span style={{ ...styles.pill, background: priority.color + "33", color: priority.color }}>
                                {priority.label}
                              </span>
                            )}
                          </div>
                        );
                      })}
                      <div style={styles.addTaskRow} onClick={() => openNewTask(cat.id)}>
                        <Plus size={12} />
                        <span>Adicionar tarefa</span>
                      </div>
                    </div>
                  )}
                </div>
              ))}

              {!addingCategory && (
                <button style={styles.addCategoryBtn} onClick={() => setAddingCategory(true)}>
                  + Adicionar categoria
                </button>
              )}

              {addingCategory && (
                <div style={styles.addCategoryForm}>
                  <input
                    autoFocus
                    placeholder="Nome da categoria"
                    value={newCatName}
                    onChange={(e) => setNewCatName(e.target.value)}
                    onKeyDown={(e) => e.key === "Enter" && addCategory()}
                    style={{ ...styles.input, marginBottom: 10 }}
                  />
                  <div style={{ display: "flex", gap: 6, marginBottom: 10 }}>
                    {CATEGORY_COLORS.map((c) => (
                      <div
                        key={c.value}
                        onClick={() => setNewCatColor(c.value)}
                        style={{
                          width: 24,
                          height: 24,
                          borderRadius: 6,
                          background: c.value,
                          cursor: "pointer",
                          border: newCatColor === c.value ? "2px solid #eceae4" : "2px solid transparent",
                        }}
                        title={c.name}
                      />
                    ))}
                  </div>
                  <div style={{ display: "flex", gap: 6 }}>
                    <button style={styles.primaryBtnSm} onClick={addCategory}>
                      Criar
                    </button>
                    <button style={styles.secondaryBtnSm} onClick={() => setAddingCategory(false)}>
                      Cancelar
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* task panel */}
      {panelTask && (
        <>
          <div style={styles.overlay} onClick={() => setPanelTask(null)} />
          <TaskPanel
            key={panelTask.isNew ? "new" : panelTask.taskId}
            mode={panelTask.isNew ? "new" : "edit"}
            categories={tabData.categories}
            categoryId={panelTask.categoryId}
            task={panelTask.isNew ? panelTask.draft : openTaskObj}
            onClose={() => setPanelTask(null)}
            onSaveNew={(task: any) => saveNewTask(panelTask.categoryId, task)}
            onPatch={(patch: any) => patchTask(panelTask.categoryId, panelTask.taskId, patch)}
            onDelete={() => deleteTask(panelTask.categoryId, panelTask.taskId)}
            onMove={(toCatId: string) => moveTaskToCategory(panelTask.categoryId, panelTask.taskId, toCatId)}
          />
        </>
      )}

      {/* confirm dialog */}
      {confirmState && (
        <div style={styles.confirmOverlay} onClick={() => setConfirmState(null)}>
          <div style={styles.confirmCard} onClick={(e) => e.stopPropagation()}>
            <p style={styles.confirmMessage}>{confirmState.message}</p>
            <div style={{ display: "flex", gap: 8, justifyContent: "flex-end" }}>
              <button style={styles.secondaryBtnSm} onClick={() => setConfirmState(null)}>
                Cancelar
              </button>
              <button style={styles.dangerBtnSm} onClick={confirmState.onConfirm}>
                Excluir
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ---------- side panel ----------
function TaskPanel({ mode, categories, categoryId, task, onClose, onSaveNew, onPatch, onDelete, onMove }: any) {
  const [draft, setDraft] = useState(task);
  const [newItem, setNewItem] = useState("");

  useEffect(() => setDraft(task), [task]);

  function commit(patch: any) {
    const next = { ...draft, ...patch };
    setDraft(next);
    if (mode === "edit") onPatch(patch);
  }

  function addChecklistItem() {
    const text = newItem.trim();
    if (!text) return;
    commit({ checklist: [...draft.checklist, { id: uid(), text, done: false }] });
    setNewItem("");
  }
  function toggleChecklistItem(id: string) {
    commit({ checklist: draft.checklist.map((i: any) => (i.id === id ? { ...i, done: !i.done } : i)) });
  }
  function removeChecklistItem(id: string) {
    commit({ checklist: draft.checklist.filter((i: any) => i.id !== id) });
  }

  return (
    <div style={styles.panel}>
      <div style={styles.panelHeader}>
        <span style={styles.panelHeaderLabel}>{mode === "new" ? "Nova tarefa" : "Detalhes"}</span>
        <button style={styles.iconBtnPlain} onClick={onClose}>
          <X size={16} />
        </button>
      </div>

      <div style={styles.panelBody} className="mm-scroll">
        <input
          autoFocus
          placeholder="Título da tarefa"
          value={draft.title}
          onChange={(e) => commit({ title: e.target.value })}
          style={{ ...styles.input, fontSize: 16, fontWeight: 600, marginBottom: 14 }}
        />
        <textarea
          placeholder="Descrição (opcional)"
          value={draft.description}
          onChange={(e) => commit({ description: e.target.value })}
          style={{ ...styles.input, minHeight: 70, resize: "vertical", marginBottom: 16 }}
        />

        <label style={styles.fieldLabel}>Prioridade</label>
        <div style={{ display: "flex", gap: 6, marginBottom: 16 }}>
          {PRIORITIES.map((p) => (
            <button
              key={p.key}
              onClick={() => commit({ priority: p.key })}
              style={{
                ...styles.priorityChip,
                borderColor: draft.priority === p.key ? p.color : "rgba(255,255,255,0.1)",
                color: draft.priority === p.key ? p.color : "#8b8f98",
              }}
            >
              {p.label}
            </button>
          ))}
        </div>

        <label style={styles.fieldLabel}>Prazo</label>
        <input
          type="date"
          value={draft.dueDate}
          onChange={(e) => commit({ dueDate: e.target.value })}
          style={{ ...styles.input, marginBottom: 16, colorScheme: "dark" }}
        />

        {mode === "edit" && categories.length > 1 && (
          <>
            <label style={styles.fieldLabel}>Categoria</label>
            <select value={categoryId} onChange={(e) => onMove(e.target.value)} style={{ ...styles.input, marginBottom: 16 }}>
              {categories.map((c: any) => (
                <option key={c.id} value={c.id}>
                  {c.name}
                </option>
              ))}
            </select>
          </>
        )}

        <label style={styles.fieldLabel}>Checklist</label>
        <div style={{ marginBottom: 10 }}>
          {draft.checklist.map((item: any) => (
            <div key={item.id} style={styles.checklistRow}>
              <div onClick={() => toggleChecklistItem(item.id)} style={{ ...styles.checkboxSm, background: item.done ? "#8fa998" : "transparent" }}>
                {item.done ? "✓" : ""}
              </div>
              <span
                style={{
                  flex: 1,
                  textDecoration: item.done ? "line-through" : "none",
                  color: item.done ? "#71757e" : "#d7d5cf",
                }}
              >
                {item.text}
              </span>
              <button style={styles.iconBtnPlain} onClick={() => removeChecklistItem(item.id)}>
                <X size={13} />
              </button>
            </div>
          ))}
        </div>
        <div style={{ display: "flex", gap: 6 }}>
          <input
            placeholder="Adicionar item…"
            value={newItem}
            onChange={(e) => setNewItem(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && addChecklistItem()}
            style={{ ...styles.input, flex: 1 }}
          />
          <button style={styles.secondaryBtnSm} onClick={addChecklistItem}>
            Add
          </button>
        </div>
      </div>

      <div style={styles.panelFooter}>
        {mode === "new" ? (
          <button style={styles.primaryBtn} onClick={() => onSaveNew(draft)} disabled={!draft.title.trim()}>
            Criar tarefa
          </button>
        ) : (
          <button style={styles.dangerBtn} onClick={onDelete}>
            Excluir tarefa
          </button>
        )}
      </div>
    </div>
  );
}

